{
  "openapi": "3.0.1",
  "info": {
    "title": "Metalurgica.Api",
    "version": "1.0"
  },
  "paths": {
    "/api/Embalagens": {
      "get": {
        "tags": [
          "Embalagens"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/Login": {
      "post": {
        "tags": [
          "Login"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/Lotes": {
      "post": {
        "tags": [
          "Lotes"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoteRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LoteRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/LoteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/Produtos": {
      "get": {
        "tags": [
          "Produtos"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      },
      "post": {
        "tags": [
          "Produtos"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProdutoRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ProdutoRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ProdutoRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/Quesitos": {
      "get": {
        "tags": [
          "Quesitos"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EmbalagemRequest": {
        "type": "object",
        "properties": {
          "idEmbalagem": {
            "type": "integer",
            "format": "int32"
          },
          "quantidade": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "LoginRequest": {
        "required": [
          "email",
          "senha"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string"
          },
          "senha": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "LoteRequest": {
        "type": "object",
        "properties": {
          "idProduto": {
            "type": "integer",
            "format": "int32"
          },
          "identificador": {
            "type": "string",
            "nullable": true
          },
          "dataFabricacao": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "nome": {
            "type": "string",
            "nullable": true
          },
          "validador": {
            "type": "string",
            "nullable": true
          },
          "dataValidade": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ProdutoRequest": {
        "type": "object",
        "properties": {
          "idProduto": {
            "type": "integer",
            "format": "int32"
          },
          "nome": {
            "type": "string",
            "nullable": true
          },
          "descricao": {
            "type": "string",
            "nullable": true
          },
          "especificacao": {
            "type": "string",
            "nullable": true
          },
          "emissao": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "validade": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "versao": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "io": {
            "type": "string",
            "nullable": true
          },
          "setor": {
            "type": "string",
            "nullable": true
          },
          "especie": {
            "type": "string",
            "nullable": true
          },
          "embalagens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EmbalagemRequest"
            },
            "nullable": true
          },
          "quesitos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuesitoRequest"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "QuesitoRequest": {
        "type": "object",
        "properties": {
          "idQuesito": {
            "type": "integer",
            "format": "int32"
          },
          "ideal": {
            "type": "number",
            "format": "double"
          },
          "minimo": {
            "type": "number",
            "format": "double"
          },
          "maximo": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      }
    }
  }
}